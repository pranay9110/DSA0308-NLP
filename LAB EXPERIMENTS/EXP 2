def check_string(s):
    state = 0

    for ch in s:
        if ch == 'a':
            state = 1
        elif ch == 'b':
            if state == 1:
                state = 2
            else:
                state = 0
        else:
            state = 0

    if state == 2:
        print("Accepted")
    else:
        print("Rejected")

s = input("Enter a string: ")
check_string(s)

